# このファイルを .env にコピーして使用してください（.env はgit管理外です）
# cp .env.example .env

# キャラクター/スタイル画像を置いているフォルダへのパス。
# 配下に characters/ と styles/ サブフォルダを作り、以下の命名規則で配置します。
#   images/characters/<キャラ名（CV表記を除いたもの）>.png   例: images/characters/水瀬いちご.png
#   images/styles/<キャラ名>_<スタイル名>.png                 例: images/styles/茅森月歌_Glorious Blades.png
# 画像が見つからない場合はアプリ側でプレースホルダー表示にフォールバックします。
IMAGES_DIR=./images
